{
  "name": "kervan-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Kervan's OAuth 2.1 authorization server for MCP (CIMD, private_key_jwt, client_credentials, RFC 8707)",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
